%% fptharvard.bbx -- Harvard references as in "Harvard Style Referencing"
%% (Curtin University guide supplied by the supervisor). Tested in tests/harvard.
\ProvidesFile{fptharvard.bbx}[2026/11/25 v1.0 Harvard (Curtin) bibliography style]
\RequireBibliographyStyle{authoryear}
\ExecuteBibliographyOptions{uniquename=init,giveninits=true,maxcitenames=3,mincitenames=1,maxbibnames=99,
  uniquelist=false,dashed=false,labeldate=year,sorting=nyt,
  dateabbrev=false,isbn=false,doi=false,eprint=false,useprefix=true,block=none}

\newtoggle{fpt@first}
\newtoggle{fpt@urlend}
% names: "Leeder, S.R., Dobson, A.J. & Mariot, D.L."
\renewrobustcmd*{\bibinitdelim}{}
\DeclareDelimFormat[bib,biblist]{finalnamedelim}{\addspace\&\space}
\DeclareDelimFormat[bib,biblist]{multinamedelim}{\addcomma\space}
\DeclareNameAlias{sortname}{family-given}
\DeclareNameAlias{author}{family-given}
\DeclareNameAlias{fptinnames}{given-family}
\DeclareLabeldate{\field{date}\field{year}\literal{nodate}}
\DefineBibliographyExtras{english}{\protected\def\bibrangedash{-\penalty\hyphenpenalty}}
\DefineBibliographyExtras{british}{\protected\def\bibrangedash{-\penalty\hyphenpenalty}}
\renewcommand*{\finentrypunct}{\iftoggle{fpt@urlend}{}{\addperiod}}
\renewcommand*{\bibfont}{\normalfont\raggedright}

% titles: containers italic, parts roman and unquoted
\DeclareFieldFormat*{title}{#1}
\DeclareFieldFormat*{fpt:emph}{\mkbibemph{#1}}
\DeclareFieldFormat*{volume}{vol\adddot~#1}
\DeclareFieldFormat*{number}{no\adddot~#1}
\DeclareFieldFormat*{pages}{\mkpageprefix[bookpagination]{#1}}
\DeclareFieldFormat{fpt:bracket}{\mkbibbrackets{#1}}

% \fpt@put{code}: print a unit, separated by a space after the date and by a comma later
\newcommand*{\fpt@put}[1]{\iftoggle{fpt@first}{\setunit{\addspace}}{\setunit{\addcomma\space}}%
  #1\togglefalse{fpt@first}}
\newcommand*{\fpt@field}[2][]{\iffieldundef{#2}{}{\fpt@put{\printfield[#1]{#2}}}}
\newcommand*{\fpt@list}[1]{\iflistundef{#1}{}{\fpt@put{\printlist{#1}}}}

\newbibmacro*{fpt:date}{\printtext[parens]{%
  \iffieldundef{labelyear}{\bibstring{nodate}}{\printfield{labelyear}\printfield{extradate}}}}
% #1 = format of a title that stands in for a missing author
\newbibmacro*{fpt:label}[1]{%
  \togglefalse{fpt@urlend}%
  \ifnameundef{author}
    {\ifnameundef{editor}
       {\printfield[#1]{title}\iffieldundef{titleaddon}{}{\setunit{\addspace}\printfield[fpt:bracket]{titleaddon}}%
        \clearfield{title}\clearfield{titleaddon}}
       {\printnames[family-given]{editor}\setunit{\addspace}%
        \printtext[parens]{\ifnumgreater{\value{editor}}{1}{eds\adddot}{ed\adddot}}%
        \clearname{editor}}}
    {\printnames{author}}%
  \setunit{\addspace}\usebibmacro{fpt:date}\toggletrue{fpt@first}}
\newbibmacro*{fpt:title}[1]{\iffieldundef{title}{}{\fpt@put{\printfield[#1]{title}%
  \iffieldundef{subtitle}{}{\setunit{\addcolon\space}\printfield[#1]{subtitle}}}}%
  \iffieldundef{version}{}{\setunit{\addspace}\printtext[parens]{version \thefield{version}}}%
  \iffieldundef{titleaddon}{}{\setunit{\addspace}\printfield[fpt:bracket]{titleaddon}}}
\newbibmacro*{fpt:edition}{\iffieldundef{edition}{}{\fpt@put{\printtext{\iffieldint{edition}{\mkbibordedition{\thefield{edition}}}{\thefield{edition}} edn}}}}
\newbibmacro*{fpt:publisher}{\fpt@list{publisher}\fpt@list{institution}\fpt@list{organization}\fpt@list{location}}
\newbibmacro*{fpt:daymonth}{\iffieldundef{month}{}{\fpt@put{\printtext{%
  \iffieldundef{day}{}{\stripzeros{\thefield{day}}\addspace}\mkbibmonth{\thefield{month}}}}}}
% ". Retrieved October 31, 2002, from http://..." or "... from NetLibrary database."
\newbibmacro*{fpt:retrieved}{%
  \ifboolexpr{test {\iffieldundef{url}} and test {\iffieldundef{usera}}}{}
   {\iftoggle{fpt@first}{\setunit{\addspace}}{\setunit{\addperiod\space}}%
    \printtext{Retrieved%
      \iffieldundef{urlyear}{}{\addspace\mkbibmonth{\thefield{urlmonth}}\addspace\stripzeros{\thefield{urlday}}\addcomma\space\thefield{urlyear}\addcomma}%
      \addspace from\addspace}%
    \iffieldundef{usera}{\printfield[fpt:url]{url}\toggletrue{fpt@urlend}}{\printfield{usera}}}}
\DeclareFieldFormat{fpt:url}{\url{#1}}
\newbibmacro*{fpt:in}{\iffieldundef{booktitle}{}{%
  \ifnameundef{editor}{}{\fpt@put{\printtext{in\addspace}}\setunit{}\printnames[given-family]{editor}%
    \setunit{\addspace}\printtext[parens]{\ifnumgreater{\value{editor}}{1}{eds\adddot}{ed\adddot}}}%
  \fpt@put{\printfield[fpt:emph]{booktitle}}}}
\newbibmacro*{fpt:journal}{\fpt@field[fpt:emph]{journaltitle}\fpt@field{volume}\fpt@field{number}%
  \iffieldundef{volume}{\usebibmacro{fpt:daymonth}}{}\fpt@field{pages}}
\newbibmacro*{fpt:eprint}{\iffieldundef{eprint}{}{\fpt@put{\printtext{%
  \iffieldequalstr{eprinttype}{arxiv}{arXiv\addcolon}{\thefield{eprinttype}\addcolon}\thefield{eprint}}}}}
\newbibmacro*{fpt:finish}{\usebibmacro{fpt:retrieved}\usebibmacro{finentry}}

\newcommand*{\fpt@driver}[2]{\DeclareBibliographyDriver{#1}{\usebibmacro{bibindex}\usebibmacro{begentry}#2\usebibmacro{fpt:finish}}}
\fpt@driver{article}{\usebibmacro{fpt:label}{title}\usebibmacro{fpt:title}{title}\usebibmacro{fpt:journal}\usebibmacro{fpt:eprint}}
\fpt@driver{book}{\usebibmacro{fpt:label}{fpt:emph}\usebibmacro{fpt:title}{fpt:emph}\usebibmacro{fpt:edition}\fpt@field{volume}\usebibmacro{fpt:publisher}}
\fpt@driver{incollection}{\usebibmacro{fpt:label}{title}\usebibmacro{fpt:title}{title}\usebibmacro{fpt:in}\usebibmacro{fpt:publisher}\fpt@field{pages}}
\fpt@driver{inproceedings}{\usebibmacro{fpt:label}{title}\usebibmacro{fpt:title}{title}\fpt@field[fpt:emph]{booktitle}\fpt@field{volume}\usebibmacro{fpt:publisher}\fpt@field{pages}\usebibmacro{fpt:eprint}}
\fpt@driver{thesis}{\usebibmacro{fpt:label}{title}\usebibmacro{fpt:title}{title}\fpt@field{type}\fpt@list{institution}\fpt@list{location}}
\fpt@driver{report}{\usebibmacro{fpt:label}{fpt:emph}\usebibmacro{fpt:title}{fpt:emph}\fpt@field{volume}\fpt@field{type}\fpt@field{number}\usebibmacro{fpt:publisher}}
\fpt@driver{online}{\usebibmacro{fpt:label}{fpt:emph}\usebibmacro{fpt:title}{fpt:emph}\usebibmacro{fpt:eprint}\usebibmacro{fpt:publisher}}
\fpt@driver{misc}{\usebibmacro{fpt:label}{fpt:emph}\usebibmacro{fpt:title}{fpt:emph}\fpt@field{howpublished}\usebibmacro{fpt:eprint}\usebibmacro{fpt:publisher}\usebibmacro{fpt:daymonth}}
\fpt@driver{patent}{\usebibmacro{fpt:label}{fpt:emph}\usebibmacro{fpt:title}{fpt:emph}\fpt@put{\printtext{\thefield{type}\addspace\thefield{number}}}}
\DeclareBibliographyAlias{inbook}{incollection}
\DeclareBibliographyAlias{collection}{book}
\DeclareBibliographyAlias{proceedings}{book}
\DeclareBibliographyAlias{manual}{book}
\DeclareBibliographyAlias{booklet}{book}
\DeclareBibliographyAlias{software}{misc}
\DeclareBibliographyAlias{dataset}{misc}
\DeclareBibliographyAlias{unpublished}{misc}
\DeclareBibliographyAlias{standard}{report}
\DeclareBibliographyAlias{*}{misc}
\DeclareFieldFormat[report,patent]{number}{#1}
\DeclareFieldFormat[thesis]{type}{\ifbibstring{#1}{\bibstring{#1}}{#1}}

\defbibenvironment{bibliography}
  {\list{}{\setlength{\leftmargin}{\bibhang}\setlength{\itemindent}{-\leftmargin}%
     \setlength{\itemsep}{\bibitemsep}\setlength{\parsep}{\parskip}\setlength{\topsep}{0pt}}}
  {\endlist}{\item}
\endinput
